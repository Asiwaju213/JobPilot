# JobPilot — Environment variables (example)

# ──────────────────────────────────────────────
# Required
# ──────────────────────────────────────────────
# PostgreSQL connection string. Example:
#   postgresql://username:password@localhost:5432/jobpilot
DATABASE_URL="postgresql://postgres:***@localhost:5432/jobpilot"

# Secret used to sign session cookies. MUST be a long random string in production.
COOKIE_SECRET="change-me-in-production"

# ──────────────────────────────────────────────
# Optional
# ──────────────────────────────────────────────
# HTTP port (default 8080)
PORT=8080

# Host to bind to (default 0.0.0.0)
HOST=0.0.0.0

# Node environment (default development)
NODE_ENV=development
