# JobPilot — Frontend environment variables (example)

# Vite dev server proxy target (backend API URL).
# In production, the frontend is served from the same origin as the backend,
# so this can be omitted or set to the same origin.
VITE_API_BASE_URL="http://localhost:8080"

# Or use a relative base for relative API calls (recommended for production):
# VITE_API_BASE_URL="/api"
